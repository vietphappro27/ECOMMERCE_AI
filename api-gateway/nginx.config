limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;

log_format gateway_json escape=json
  '{"time":"$time_iso8601","remote_addr":"$remote_addr","request_id":"$request_id",'
  '"method":"$request_method","uri":"$request_uri","status":$status,'
  '"body_bytes_sent":$body_bytes_sent,"request_time":$request_time,'
  '"upstream_addr":"$upstream_addr","upstream_status":"$upstream_status",'
  '"upstream_response_time":"$upstream_response_time","user_agent":"$http_user_agent"}';

server {
	listen 8000;
	server_name _;

	access_log /var/log/nginx/access.log gateway_json;
	error_log /var/log/nginx/error.log warn;

	add_header X-Frame-Options DENY always;
	add_header X-Content-Type-Options nosniff always;
	add_header Referrer-Policy no-referrer always;
	add_header X-XSS-Protection "1; mode=block" always;

	limit_req zone=api_limit burst=60 nodelay;

	location = /health {
		return 200 '{"status":"ok","service":"api-gateway-nginx"}';
		add_header Content-Type application/json;
	}

	location = / {
		proxy_pass http://api-gateway-ui:8010/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /ui/ {
		proxy_pass http://api-gateway-ui:8010/ui/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /api/ {
		proxy_pass http://api-gateway-ui:8010/api/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /static/ {
		proxy_pass http://api-gateway-ui:8010/static/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location = /_auth {
		internal;
		proxy_pass http://user-service:8001/auth/verify/;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Authorization $http_authorization;
		proxy_set_header X-Required-Role "";
	}

	location = /_auth_staff {
		internal;
		proxy_pass http://user-service:8001/auth/verify/;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Authorization $http_authorization;
		proxy_set_header X-Required-Role STAFF;
	}

	location = /_auth_admin {
		internal;
		proxy_pass http://user-service:8001/auth/verify/;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Authorization $http_authorization;
		proxy_set_header X-Required-Role ADMIN;
	}

	location /auth/ {
		proxy_pass http://user-service:8001/auth/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /customer/register/ {
		proxy_pass http://user-service:8001/customer/register/;
	}

	location /customer/login/ {
		proxy_pass http://user-service:8001/customer/login/;
	}

	location /staff/register/ {
		proxy_pass http://user-service:8001/staff/register/;
	}

	location /staff/login/ {
		proxy_pass http://user-service:8001/staff/login/;
	}

	location /admin/register/ {
		proxy_pass http://user-service:8001/admin/register/;
	}

	location /admin/login/ {
		proxy_pass http://user-service:8001/admin/login/;
	}

	location /users/ {
		auth_request /_auth;
		proxy_pass http://user-service:8001/users/;
		proxy_set_header Authorization $http_authorization;
	}

	location /roles/ {
		auth_request /_auth_admin;
		proxy_pass http://user-service:8001/roles/;
		proxy_set_header Authorization $http_authorization;
	}

	location /user-roles/ {
		auth_request /_auth_admin;
		proxy_pass http://user-service:8001/user-roles/;
		proxy_set_header Authorization $http_authorization;
	}

	location /behaviors/ {
		auth_request /_auth;
		proxy_pass http://user-service:8001/behaviors/;
		proxy_set_header Authorization $http_authorization;
	}

	location /products/ {
		auth_request /_auth;
		proxy_pass http://product-service:8003/products/;
		proxy_set_header Authorization $http_authorization;
	}

	location /categories/ {
		auth_request /_auth_staff;
		proxy_pass http://product-service:8003/categories/;
		proxy_set_header Authorization $http_authorization;
	}

	location /carts/ {
		auth_request /_auth;
		proxy_pass http://cart-service:8004/carts/;
		proxy_set_header Authorization $http_authorization;
	}

	location /cart-items/ {
		auth_request /_auth;
		proxy_pass http://cart-service:8004/cart-items/;
		proxy_set_header Authorization $http_authorization;
	}

	location /orders/ {
		auth_request /_auth;
		proxy_pass http://order-service:8006/orders/;
		proxy_set_header Authorization $http_authorization;
	}

	location /payments/ {
		auth_request /_auth;
		proxy_pass http://payment-service:8007/payments/;
		proxy_set_header Authorization $http_authorization;
	}

	location /shipments/ {
		auth_request /_auth;
		proxy_pass http://ship-service:8008/shipments/;
		proxy_set_header Authorization $http_authorization;
	}

	location /recommend {
		auth_request /_auth;
		proxy_pass http://ai-service:8005/recommend;
		proxy_set_header Authorization $http_authorization;
	}

	location /chatbot {
		auth_request /_auth;
		proxy_pass http://ai-service:8005/chatbot;
		proxy_set_header Authorization $http_authorization;
	}
}
